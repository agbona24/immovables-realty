# EmailJS Configuration
# Get these from your EmailJS dashboard: https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Sanity CMS Configuration
# Get these values from https://www.sanity.io/manage

# Required: Your Sanity project ID (found in sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Required: Dataset name (usually "production" or "development")
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: API version (defaults to current date format)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: Token for preview/draft content (create in sanity.io/manage > API > Tokens)
SANITY_API_READ_TOKEN=your_read_token_here